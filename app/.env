# Este archivo es un PLACEHOLDER seguro para el repositorio.
# Para desarrollo local, copia este archivo como .env.local y agrega tus valores reales.
# En CI/CD, los secrets se inyectan como variables de entorno del pipeline.

BASE_URL=http://192.168.1.16:3000
FIREBASE_PROJECT_ID=
JWT_SECRET=
# Clave de firma de la credencial QR (HMAC-SHA256).
# DEBE coincidir con CREDENTIAL_SECRET del backend.
CREDENTIAL_SECRET=NAVIA_TecNM_2026_SecretKey
