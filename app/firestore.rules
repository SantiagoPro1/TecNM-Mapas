rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email != null && (
          request.auth.token.email.lower() == '23460706@colima.tecnm.mx' ||
          request.auth.token.email.lower() == '23460706@tecnm.mx' ||
          request.auth.token.email.lower() == 'alira@colima.tecnm.mx' ||
          request.auth.token.email.lower() == 'hcastrejon@colima.tecnm.mx' ||
          request.auth.token.email.lower() == 'jorge.chavez@colima.tecnm.mx' ||
          request.auth.token.email.lower().matches('.*23460706@.*tecnm\\.mx.*') ||
          request.auth.token.email.lower().matches('.*23460706@.*')
        ))
      );
    }

    // Rol de administrador. Solo se puede leer el propio; escrituras
    // únicamente desde la consola de Firebase o el Admin SDK (nunca desde
    // el cliente), para que nadie pueda auto-promoverse.
    match /admins/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if false;
    }

    // Versión de los datos de sedes y actualizaciones de la app.
    // Lectura pública; escritura restringida a administradores autorizados.
    match /app_meta/{documento} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Sedes y sus subcolecciones (lugares, nodos y aristas).
    // Lectura pública; escrituras, modificaciones y eliminaciones exclusivas de administradores.
    match /venues/{venueId} {
      allow read: if true;
      allow write: if isAdmin();

      match /places/{placeId} {
        allow read: if true;
        allow write: if isAdmin();
      }
      match /nodes/{nodeId} {
        allow read: if true;
        allow write: if isAdmin();
      }
      match /edges/{edgeId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    // Colección plana heredada (solo-lectura, admin para escribir)
    match /places/{placeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Feed de anuncios institucionales
    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
