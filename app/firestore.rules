rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Rol de administrador. Solo se puede leer el propio; escrituras
    // únicamente desde la consola de Firebase o el Admin SDK (nunca desde
    // el cliente), para que nadie pueda auto-promoverse.
    match /admins/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // Versión de los datos de sedes. Un único documento
    // (`app_meta/venue_data`, campo `dataVersion`) que le dice a la app si
    // los puntos empaquetados en el APK siguen al día.
    //
    // Es la ÚNICA lectura de Firestore que hace un usuario normal en el
    // camino feliz: todo lo demás sale del APK. Por eso el consumo se
    // mantiene dentro del tramo gratuito aun con 40,000 asistentes.
    //
    // Cuando el administrador edita puntos, debe subir `dataVersion` en 1
    // para que los teléfonos vuelvan a leer de Firestore.
    match /app_meta/{documento} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Sedes (TecNM Colima, Sendera, Zentralia, sedes del Evento Nacional
    // Deportivo) y sus subcolecciones. Lectura pública: los invitados sin
    // cuenta necesitan ver el mapa. Escritura solo para administradores.
    match /venues/{venueId} {
      allow read: if true;
      allow write: if isAdmin();

      match /places/{placeId} {
        allow read: if true;
        allow write: if isAdmin();
      }
      match /nodes/{nodeId} {
        allow read: if true;
        allow write: if isAdmin();
      }
      match /edges/{edgeId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    // Colección plana heredada (la que llenaba el seedData() original antes
    // de migrar a `venues/{id}/places`). Se deja de solo-lectura por
    // compatibilidad; ya no acepta escrituras sin rol de admin.
    match /places/{placeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Feed de anuncios (feed_service.dart) — no tenía reglas propias hasta
    // ahora (este archivo no existía en el repo).
    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
