# ─── SINAIT Backend Config ─────────────────────────────────────

# Servidor
PORT=3000
NODE_ENV=development

# Firebase
FIREBASE_PROJECT_ID=sinait-colima
# En producción, descomentar y apuntar al service account:
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# JWT (debe coincidir con CredentialService de Flutter)
JWT_SECRET=SINAIT_TecNM_2026_SecretKey

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Clave compartida con la app para firmar/verificar la credencial QR
# (HMAC-SHA256). DEBE ser idéntica a CREDENTIAL_SECRET en app/.env.local
CREDENTIAL_SECRET=cambia_esto_por_una_clave_larga_aleatoria
